---
import Layout from "@/layouts/Layout.astro";

// Copy provisional (CONTENT_CHECKLIST fila 48): propuesta del agente, pendiente
// de aprobar por el dueño. Sin variante con/sin sesión: la sesión vive dentro
// de la isla de React y esta página no la monta (P40).
// Tema: sin React no hay `data-theme`; `variables.css` sigue el del sistema
// (`prefers-color-scheme`). El tema elegido a mano no se lee aquí: solo
// `learning-storage.ts` toca el almacenamiento.
// Márgenes por debajo de `min-[20rem]` (D215): el umbral va en rem, así que con
// la letra normal no cambia nada desde 320 px, y con el texto al 200 % a 320 px
// (20rem = 640 px) se estrechan para que "Volver a practicar" quepa en la tarjeta.
---

<Layout title="Página no encontrada — Banderas del Mundo" noindex>
	<main
		id="main-content"
		class="grid h-dvh w-full place-items-center overflow-auto p-2 min-[20rem]:p-4"
	>
		<section
			aria-labelledby="not-found-title"
			class="flex w-full max-w-card flex-col items-center gap-3 rounded-2xl border border-surface-border bg-surface p-4 text-center min-[20rem]:p-6 shadow-xl"
		>
			<p class="m-0 text-caption font-bold text-text-placeholder">Error 404</p>
			<h1 id="not-found-title" class="m-0 text-heading text-surface-soft">
				Esta página no existe
			</h1>
			<p class="m-0 text-body-sm text-text-placeholder">
				La dirección que abriste no lleva a ninguna parte del juego. Tu progreso
				sigue guardado.
			</p>
			<a
				href="/"
				class="mt-3 inline-flex min-h-11 items-center forced-colors:border justify-center rounded-md bg-primary px-4 font-bold min-[20rem]:px-5 text-accent-foreground no-underline transition-colors hover:bg-primary-hover focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-primary-hover"
			>
				Volver a practicar
			</a>
		</section>
	</main>
</Layout>
