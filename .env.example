# Copia este archivo a `.env` y rellena con los valores de tu proyecto de Supabase.
# Solo variables PUBLIC_* (se incrustan en el bundle del cliente): nunca pongas aquí
# la service role key ni otros secretos.

# Supabase → Project Settings → API
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Clave pública VAPID para las notificaciones push (opcional en desarrollo)
PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# Solo servidor (sin PUBLIC_): los valores reales viven en Vercel, por entorno.
# Se bajan con `bunx vercel env pull .env.local --yes`; nunca los pegues aquí.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
SUPABASE_PASSWORD=

# QA → .env.test.local (gitignored). Cuentas que `bun run qa:local` crea SOLO en la base
# local de Docker: valores inventados, nunca una cuenta real. No hay roles: un jugador.
EMAIL_TEST=
PASSWORD_TEST=
