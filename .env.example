# Solo los nombres: los valores viven en Vercel. Las PUBLIC_* se incrustan en el bundle del
# cliente: nunca pongas ahí un secreto.

# Clave pública VAPID para las notificaciones push (opcional en desarrollo)
PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# Solo servidor (sin PUBLIC_): los valores reales viven en Vercel, por entorno.
# Se bajan con `bunx vercel env pull .env.local --yes`; nunca los pegues aquí.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
# Solo para la importación desde Supabase (fase 6); se retira tras el corte.
SUPABASE_PASSWORD=
# Postgres en el VPS: DATABASE_URL por PgBouncer (la app), DIRECT_URL por el túnel SSH
# (migraciones). Salen de `ssh kit-vps kit-db url <base> [--direct]`, nunca a mano.
DATABASE_URL=
DIRECT_URL=
# Better Auth: el secreto firma las sesiones (`openssl rand -hex 32`). URL de producción;
# en un preview se usa la que da Vercel.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Correos de la app (Brevo). SMTP_FROM: "World Flags <remitente@verificado>".
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# QA → .env.test.local (gitignored). Cuentas que `bun run qa:local` crea SOLO en la base
# local de Docker: valores inventados, nunca una cuenta real. No hay roles: un jugador.
EMAIL_TEST=
PASSWORD_TEST=
